    "ax.set_ylabel(\"Field goal rate\")\n",
    "ax.set_title(\"Team Shooting Trend\")\n",
    "ax.yaxis.set_major_formatter(PercentFormatter(1.0))\n",
    "ax.tick_params(axis=\"x\", rotation=45)\n",
    "ax.title.set_color(ARIZONA_BLUE)\n",
    "plt.tight_layout()\n",
    "plt.show()"
