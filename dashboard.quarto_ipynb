{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Adaptive Athletics Dashboard\"\n",
        "subtitle: \"Accessible Practice Snapshot\"\n",
        "author:\n",
        "  - name: Ryan Dennehy\n",
        "    affiliation:\n",
        "      - name: University of Arizona\n",
        "format:\n",
        "  html:\n",
        "    css: dashboard.css\n",
        "toc: false\n",
        "title-block-banner: true\n",
        "---"
      ],
      "id": "089cd91c"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| label: libraries\n",
        "#| echo: false\n",
        "\n",
        "from IPython.display import HTML, display\n",
        "import html\n",
        "import json\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "from matplotlib.ticker import PercentFormatter\n",
        "from pathlib import Path\n",
        "import sys\n",
        "\n",
        "sys.path.insert(0, str(Path.cwd()))\n",
        "\n",
        "from adaptive_athletics.data_pipeline import (\n",
        "    build_player_summary,\n",
        "    build_practice_summary,\n",
        "    load_practice_data,\n",
        ")\n",
        "\n",
        "from pandas.io.formats.style import Styler\n",
        "\n",
        "ARIZONA_RED = \"#AB0520\"\n",
        "ARIZONA_BLUE = \"#0C234B\"\n",
        "ARIZONA_SAND = \"#F4EDE5\"\n",
        "\n",
        "plt.style.use(\"seaborn-v0_8-whitegrid\")\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "\n",
        "def pct(value: float) -> str:\n",
        "    if pd.isna(value):\n",
        "        return \"—\"\n",
        "    return f\"{value:.1%}\"\n",
        "\n",
        "\n",
        "def whole(value: float) -> str:\n",
        "    if pd.isna(value):\n",
        "        return \"—\"\n",
        "    return f\"{int(round(value)):,}\"\n",
        "\n",
        "\n",
        "def render_cards(cards: list[dict[str, str]], card_class: str = \"stat-card\") -> None:\n",
        "    body = \"\".join(\n",
        "        f\"\"\"\n",
        "        <article class=\"{card_class}\">\n",
        "          <p class=\"eyebrow\">{html.escape(card['label'])}</p>\n",
        "          <p class=\"big-number\">{html.escape(card['value'])}</p>\n",
        "          <p class=\"supporting-text\">{html.escape(card['note'])}</p>\n",
        "        </article>\n",
        "        \"\"\"\n",
        "        for card in cards\n",
        "    )\n",
        "    display(HTML(f'<section class=\"card-grid\" aria-label=\"Dashboard highlights\">{body}</section>'))\n",
        "\n",
        "\n",
        "def render_intro_panel(title: str, body: str) -> None:\n",
        "    display(\n",
        "        HTML(\n",
        "            f\"\"\"\n",
        "            <section class=\"intro-panel\">\n",
        "              <p class=\"eyebrow\">Dashboard Summary</p>\n",
        "              <h2 class=\"hero-title\">{html.escape(title)}</h2>\n",
        "              <p class=\"hero-copy\">{html.escape(body)}</p>\n",
        "            </section>\n",
        "            \"\"\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "def render_player_spotlight(players: list[dict[str, str]]) -> None:\n",
        "    options = \"\".join(\n",
        "        f'<option value=\"{html.escape(player[\"Name\"])}\">{html.escape(player[\"Name\"])}</option>'\n",
        "        for player in players\n",
        "    )\n",
        "    payload = json.dumps(players).replace(\"</\", \"<\\\\/\")\n",
        "    display(\n",
        "        HTML(\n",
        "            f\"\"\"\n",
        "            <section class=\"spotlight-shell\" aria-labelledby=\"player-spotlight-heading\">\n",
        "              <div class=\"spotlight-header\">\n",
        "                <div>\n",
        "                  <p class=\"eyebrow\">Interactive View</p>\n",
        "                  <h2 id=\"player-spotlight-heading\">Player Spotlight</h2>\n",
        "                  <p class=\"hero-copy\">Pick a player to see a simple performance snapshot without searching through every table.</p>\n",
        "                </div>\n",
        "                <div class=\"spotlight-control\">\n",
        "                  <label class=\"spotlight-label\" for=\"player-spotlight-select\">Select player</label>\n",
        "                  <select id=\"player-spotlight-select\" class=\"spotlight-select\">{options}</select>\n",
        "                </div>\n",
        "              </div>\n",
        "              <div id=\"player-spotlight-cards\" class=\"card-grid\" aria-live=\"polite\"></div>\n",
        "            </section>\n",
        "            <script>\n",
        "            (() => {{\n",
        "              const players = {payload};\n",
        "              const select = document.getElementById(\"player-spotlight-select\");\n",
        "              const cards = document.getElementById(\"player-spotlight-cards\");\n",
        "              if (!select || !cards || !players.length) return;\n",
        "              const render = (name) => {{\n",
        "                const player = players.find((item) => item.Name === name) || players[0];\n",
        "                cards.innerHTML = `\n",
        "                  <article class=\"stat-card\">\n",
        "                    <p class=\"eyebrow\">Name</p>\n",
        "                    <p class=\"big-number\">${{player.Name}}</p>\n",
        "                    <p class=\"supporting-text\">${{player.Practices}} practices tracked</p>\n",
        "                  </article>\n",
        "                  <article class=\"stat-card\">\n",
        "                    <p class=\"eyebrow\">Field Goal Rate</p>\n",
        "                    <p class=\"big-number\">${{player[\"FG %\"]}}</p>\n",
        "                    <p class=\"supporting-text\">${{player[\"FG Makes\"]}} makes on ${{player[\"FG Attempts\"]}} attempts</p>\n",
        "                  </article>\n",
        "                  <article class=\"stat-card\">\n",
        "                    <p class=\"eyebrow\">Free Throw Rate</p>\n",
        "                    <p class=\"big-number\">${{player[\"FT %\"]}}</p>\n",
        "                    <p class=\"supporting-text\">${{player[\"FT Makes\"]}} makes on ${{player[\"FT Attempted\"]}} attempts</p>\n",
        "                  </article>\n",
        "                  <article class=\"insight-card\">\n",
        "                    <p class=\"eyebrow\">Defensive Activity</p>\n",
        "                    <p class=\"big-number\">${{player[\"Defensive Events\"]}}</p>\n",
        "                    <p class=\"supporting-text\">${{player[\"Forced TO\"]}} forced turnovers and ${{player[\"Blocks\"]}} blocks</p>\n",
        "                  </article>\n",
        "                `;\n",
        "              }};\n",
        "              select.addEventListener(\"change\", (event) => render(event.target.value));\n",
        "              render(select.value);\n",
        "            }})();\n",
        "            </script>\n",
        "            \"\"\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "def style_table(styler: Styler) -> Styler:\n",
        "    return styler.set_table_styles(\n",
        "        [\n",
        "            {\"selector\": \"th\", \"props\": [(\"padding\", \"0.75rem 1rem\")]},\n",
        "            {\"selector\": \"td\", \"props\": [(\"padding\", \"0.75rem 1rem\")]},\n",
        "            {\n",
        "                \"selector\": \"thead th\",\n",
        "                \"props\": [\n",
        "                    (\"background-color\", ARIZONA_BLUE),\n",
        "                    (\"color\", \"white\"),\n",
        "                    (\"font-weight\", \"700\"),\n",
        "                ],\n",
        "            },\n",
        "        ],\n",
        "        overwrite=False,\n",
        "    )\n",
        "\n",
        "\n",
        "def display_name(first_name: str, last_name: str, fallback: str) -> str:\n",
        "    first = (first_name or \"\").strip()\n",
        "    last = (last_name or \"\").strip()\n",
        "    if first == \"Abby\" and last:\n",
        "        return last\n",
        "    if first:\n",
        "        return first\n",
        "    return fallback"
      ],
      "id": "libraries",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: data\n",
        "#| echo: false\n",
        "\n",
        "practice_data = load_practice_data(\"Data\")\n",
        "player_summary = build_player_summary(practice_data)\n",
        "practice_summary = build_practice_summary(practice_data)\n",
        "\n",
        "player_summary[\"Name\"] = player_summary.apply(\n",
        "    lambda row: display_name(row[\"First Name\"], row[\"Last Name\"], row[\"player_name\"]),\n",
        "    axis=1,\n",
        ")\n",
        "player_summary[\"Defensive Events\"] = player_summary[\"Forced TO\"] + player_summary[\"Blocks\"]\n",
        "player_summary[\"Attempts per Practice\"] = player_summary[\"FG Attempts\"] / player_summary[\"Practices\"]\n",
        "\n",
        "practice_summary[\"Date\"] = practice_summary[\"practice_label\"]\n",
        "\n",
        "qualified_shooters = player_summary.loc[player_summary[\"FG Attempts\"] >= 25].copy()\n",
        "top_volume = player_summary.iloc[0]\n",
        "top_efficiency = qualified_shooters.sort_values([\"FG %\", \"FG Attempts\"], ascending=[False, False]).iloc[0]\n",
        "top_defense = player_summary.sort_values(\n",
        "    [\"Defensive Events\", \"Forced TO\", \"Blocks\"],\n",
        "    ascending=[False, False, False],\n",
        ").iloc[0]\n",
        "latest_practice = practice_summary.iloc[-1]\n",
        "best_practice = practice_summary.sort_values([\"FG %\", \"FG Attempts\"], ascending=[False, False]).iloc[0]\n",
        "\n",
        "player_spotlight = (\n",
        "    player_summary.loc[\n",
        "        :,\n",
        "        [\n",
        "            \"Name\",\n",
        "            \"Practices\",\n",
        "            \"FG Attempts\",\n",
        "            \"FG Makes\",\n",
        "            \"FG %\",\n",
        "            \"FT Attempted\",\n",
        "            \"FT Makes\",\n",
        "            \"FT %\",\n",
        "            \"Forced TO\",\n",
        "            \"Blocks\",\n",
        "            \"Defensive Events\",\n",
        "        ],\n",
        "    ]\n",
        "    .sort_values(\"Name\")\n",
        "    .assign(\n",
        "        **{\n",
        "            \"Practices\": lambda df: df[\"Practices\"].map(whole),\n",
        "            \"FG Attempts\": lambda df: df[\"FG Attempts\"].map(whole),\n",
        "            \"FG Makes\": lambda df: df[\"FG Makes\"].map(whole),\n",
        "            \"FG %\": lambda df: df[\"FG %\"].map(pct),\n",
        "            \"FT Attempted\": lambda df: df[\"FT Attempted\"].map(whole),\n",
        "            \"FT Makes\": lambda df: df[\"FT Makes\"].map(whole),\n",
        "            \"FT %\": lambda df: df[\"FT %\"].map(pct),\n",
        "            \"Forced TO\": lambda df: df[\"Forced TO\"].map(whole),\n",
        "            \"Blocks\": lambda df: df[\"Blocks\"].map(whole),\n",
        "            \"Defensive Events\": lambda df: df[\"Defensive Events\"].map(whole),\n",
        "        }\n",
        "    )\n",
        "    .to_dict(orient=\"records\")\n",
        ")"
      ],
      "id": "data",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Quick View"
      ],
      "id": "e5a853fd"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "\n",
        "render_intro_panel(\n",
        "    \"Fast, readable practice reporting\",\n",
        "    \"This dashboard pulls the most important team and player trends into one place with high-contrast cards, simplified labels, and a lighter layout than the full workbook.\",\n",
        ")\n",
        "\n",
        "render_cards(\n",
        "    [\n",
        "        {\n",
        "            \"label\": \"Overall field goal rate\",\n",
        "            \"value\": pct(practice_data[\"FG Makes\"].sum() / practice_data[\"FG Attempts\"].sum()),\n",
        "            \"note\": f\"{whole(practice_data['FG Makes'].sum())} makes on {whole(practice_data['FG Attempts'].sum())} attempts\",\n",
        "        },\n",
        "        {\n",
        "            \"label\": \"Tracked practices\",\n",
        "            \"value\": whole(practice_summary[\"Date\"].nunique()),\n",
        "            \"note\": f\"{whole(len(practice_data))} player-practice rows cleaned and included\",\n",
        "        },\n",
        "        {\n",
        "            \"label\": \"Top volume shooter\",\n",
        "            \"value\": top_volume[\"Name\"],\n",
        "            \"note\": f\"{whole(top_volume['FG Attempts'])} attempts across {whole(top_volume['Practices'])} practices\",\n",
        "        },\n",
        "        {\n",
        "            \"label\": \"Most efficient shooter\",\n",
        "            \"value\": top_efficiency[\"Name\"],\n",
        "            \"note\": f\"{pct(top_efficiency['FG %'])} on at least 25 field goal attempts\",\n",
        "        },\n",
        "    ]\n",
        ")"
      ],
      "id": "04f40d8f",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "\n",
        "render_player_spotlight(player_spotlight)"
      ],
      "id": "00429190",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## What Stands Out"
      ],
      "id": "be9bce9d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "\n",
        "render_cards(\n",
        "    [\n",
        "        {\n",
        "            \"label\": \"Best practice shooting day\",\n",
        "            \"value\": best_practice[\"Date\"],\n",
        "            \"note\": f\"{pct(best_practice['FG %'])} field goal rate\",\n",
        "        },\n",
        "        {\n",
        "            \"label\": \"Latest practice in the data\",\n",
        "            \"value\": latest_practice[\"Date\"],\n",
        "            \"note\": f\"{pct(latest_practice['FG %'])} field goal rate with {whole(latest_practice['FG Attempts'])} attempts\",\n",
        "        },\n",
        "        {\n",
        "            \"label\": \"Defensive activity leader\",\n",
        "            \"value\": top_defense[\"Name\"],\n",
        "            \"note\": f\"{whole(top_defense['Defensive Events'])} combined forced turnovers and blocks\",\n",
        "        },\n",
        "    ],\n",
        "    card_class=\"insight-card\",\n",
        ")"
      ],
      "id": "4f91bf83",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The dashboard is designed to be readable at a glance. High-contrast colors, large numbers, plain-language labels, and short summary notes make it easier to understand the team's performance quickly.\n",
        "\n",
        "## Team Details\n",
        "\n",
        "::: {.panel-tabset}\n",
        "\n",
        "### Player Leaders"
      ],
      "id": "dfe637f4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "\n",
        "leaders = (\n",
        "    player_summary.loc[:, [\"Name\", \"Practices\", \"FG Attempts\", \"FG Makes\", \"FG %\", \"Attempts per Practice\", \"Defensive Events\"]]\n",
        "    .sort_values([\"FG Attempts\", \"FG %\"], ascending=[False, False])\n",
        "    .head(10)\n",
        ")\n",
        "\n",
        "style_table(\n",
        "    leaders.style.format(\n",
        "        {\n",
        "            \"Practices\": \"{:.0f}\",\n",
        "            \"FG Attempts\": \"{:.0f}\",\n",
        "            \"FG Makes\": \"{:.0f}\",\n",
        "            \"FG %\": \"{:.1%}\",\n",
        "            \"Attempts per Practice\": \"{:.1f}\",\n",
        "            \"Defensive Events\": \"{:.0f}\",\n",
        "        },\n",
        "        na_rep=\"—\",\n",
        "    )\n",
        ")"
      ],
      "id": "1ef42948",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Practice Snapshot"
      ],
      "id": "0321a511"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "\n",
        "snapshot = practice_summary.loc[\n",
        "    :,\n",
        "    [\"Date\", \"Player Entries\", \"FG Attempts\", \"FG Makes\", \"FG %\", \"Turnovers\", \"Forced TO\", \"Blocks\"],\n",
        "].copy()\n",
        "\n",
        "style_table(\n",
        "    snapshot.style.format(\n",
        "        {\n",
        "            \"Player Entries\": \"{:.0f}\",\n",
        "            \"FG Attempts\": \"{:.0f}\",\n",
        "            \"FG Makes\": \"{:.0f}\",\n",
        "            \"FG %\": \"{:.1%}\",\n",
        "            \"Turnovers\": \"{:.0f}\",\n",
        "            \"Forced TO\": \"{:.0f}\",\n",
        "            \"Blocks\": \"{:.0f}\",\n",
        "        },\n",
        "        na_rep=\"—\",\n",
        "    )\n",
        ")"
      ],
      "id": "b1a28b3d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "## Visual Trends\n",
        "\n",
        "::: {.panel-tabset}\n",
        "\n",
        "### Shooting Trend"
      ],
      "id": "8e10bf6d"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "# | fig-cap: \"Field goal percentage by practice date.\"\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(11, 5.5))\n",
        "sns.lineplot(\n",
        "    data=practice_summary,\n",
        "    x=\"Date\",\n",
        "    y=\"FG %\",\n",
        "    marker=\"o\",\n",
        "    linewidth=2.5,\n",
        "    color=ARIZONA_BLUE,\n",
        "    ax=ax,\n",
        ")\n",
        "ax.axhline(practice_summary[\"FG %\"].mean(), linestyle=\"--\", linewidth=1.5, color=ARIZONA_RED)\n",
        "ax.set_xlabel(\"Practice date\")\n",
        "ax.set_ylabel(\"Field goal rate\")\n",
        "ax.set_title(\"Team Shooting Trend\")\n",
        "ax.yaxis.set_major_formatter(PercentFormatter(1.0))\n",
        "ax.tick_params(axis=\"x\", rotation=45)\n",
        "ax.title.set_color(ARIZONA_BLUE)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "aedcad63",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The dashed red line marks the team average. Points above that line were stronger shooting practices than the overall average.\n",
        "\n",
        "### Top Scorers By Attempts"
      ],
      "id": "09888acf"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# | echo: false\n",
        "# | fig-cap: \"Top 8 players ranked by field goal attempts.\"\n",
        "\n",
        "top_attempts = player_summary.sort_values([\"FG Attempts\", \"FG %\"], ascending=[False, False]).head(8)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10.5, 6))\n",
        "sns.barplot(\n",
        "    data=top_attempts,\n",
        "    x=\"FG Attempts\",\n",
        "    y=\"Name\",\n",
        "    color=ARIZONA_RED,\n",
        "    ax=ax,\n",
        ")\n",
        "ax.set_xlabel(\"Field goal attempts\")\n",
        "ax.set_ylabel(\"\")\n",
        "ax.set_title(\"Most Active Shooters\")\n",
        "ax.title.set_color(ARIZONA_BLUE)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "a9a9a2d4",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "This view highlights who is taking the most shots overall. It is useful for understanding role, workload, and where efficiency gains would have the biggest team impact.\n",
        "\n",
        ":::"
      ],
      "id": "890467de"
    }
  ],
